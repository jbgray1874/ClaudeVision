# ── SDI Intelligence: settings that are the same on every machine ────────────
#
# COMMITTED, ON PURPOSE. These are UNC paths and file-type lists — they are the
# same on a laptop, on SDI-APP01, and on whatever host replaces it, so keeping
# them in the repository means a new machine is configured by checking out the
# code rather than by somebody remembering.
#
# NOTHING SECRET GOES IN THIS FILE. Not a password, not an API key, not a
# connection string with credentials in it. Those live in .env, which is not
# committed and never should be. If you find yourself wanting to put one here,
# that is the signal it belongs in the other file.
#
# Anything set in .env, or in the real environment, overrides what is here.

SDI_FILE_ROOTS=\\sdi-dc01\shareddata$\Shared\Estimating\Completed\AI Estimating\AISheets|\\sdi-dc01\shareddata$\Shared\IT\AI & Automation\StatusReporting|C:\ClaudeVision\output\reports|C:\ClaudeVision\output|\\sdi-dc01\shareddata$\Shared\IT\HRSystemsOutput|\\sdi-dc01\shareddata$\Shared\Estimating\Completed\AI Estimating\Live Enquiry|\\sdi-dc01\shareddata$\Shared\IT\AI & Automation\Documentation|\\sdi-dc01\shareddata$\Shared\Estimating\Completed\Manual Estimates|\\sdi-dc01\shareddata$\Shared\Estimating\Completed\AI Estimating\parity|\\sdi-dc01\shareddata$\Shared\Estimating\Completed\Live Enquiries\completed AI briefs

# .wav: the spoken walkthroughs — the estimate's beside its workbook (D-609) and the parity
# comparison's beside its report (D-627) — are offered as /api/file links, so the extension
# must be served or the page shows a button the service then refuses.
SDI_ALLOWED_EXTENSIONS=.xlsx,.xls,.xlsm,.html,.htm,.json,.jpg,.jpeg,.png,.txt,.log,.docx,.doc,.pdf,.md,.csv,.wav

SDI_ESTIMATE_OUTPUT_ROOT=\\sdi-dc01\shareddata$\Shared\Estimating\Completed\AI Estimating\AISheets

# Parity by job number (D-619): where the manual estimates are filed, by year and client,
# and where every comparison is filed with both sheets and its report.
SDI_MANUAL_ESTIMATES_ROOT=\\sdi-dc01\shareddata$\Shared\Estimating\Completed\Manual Estimates
SDI_PARITY_ROOT=\\sdi-dc01\shareddata$\Shared\Estimating\Completed\AI Estimating\parity

SDI_DB_DRIVER=ODBC Driver 18 for SQL Server
