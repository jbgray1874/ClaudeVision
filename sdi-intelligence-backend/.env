# ════════════════════════════════════════════════════════════════════════
#  SDI Intelligence — Backend Service configuration
#  ----------------------------------------------------------------------
#  1. Copy this file to ".env"  (same folder)
#  2. Fill in every <…> placeholder with your real values
#  3. NEVER commit the populated ".env" to git / source control
#     (a .gitignore is included that already excludes it)
# ════════════════════════════════════════════════════════════════════════


# ── Service ──────────────────────────────────────────────────────────────
# Where this API listens ON THE LOCAL WINDOWS SERVER.
SDI_HOST=0.0.0.0
SDI_PORT=8071

# The portal's web address, allowed to call this API (CORS).
# Comma-separated if more than one (e.g. the SWA URL + a custom domain).
SDI_ALLOWED_ORIGINS=https://sdi-intelligence.azurestaticapps.net


# ── Access gate (interim shared secret) ──────────────────────────────────
# The portal handles the Entra ID login; THIS is a second check between the
# site and this backend. Generate one long random string and paste it bothSDI_
# here and into the portal's settings. Rotate occasionally.
#   PowerShell to generate one:  [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
SDI_API_KEY=


# ── File shares (UNC roots this API is allowed to read) ──────────────────
# Pipe-separated ( | ) list. The API will ONLY ever serve files that sit
# UNDER one of these roots — anything else is refused (403). Keep it tight.
#   Example:
#   SDI_FILE_ROOTS=\\FILESRV01\Estimating\AI Estimating|\\FILESRV01\ClaudeVision\output
#SDI_FILE_ROOTS=K:\Estimating\Completed\AI Estimating\AISheets|K:\IT\AI & Automation\StatusReporting|C:\ClaudeVision\output\reports|C:\ClaudeVision\output|K:\IT\HRSystemsOutput|K:\Estimating\Completed\AI Estimating\Live Enquiry|K:\IT\AI & Automation\Documentation
SDI_FILE_ROOTS=\\sdi-dc01\shareddata$\Shared\Estimating\Completed\AI Estimating\AISheets|\\sdi-dc01\shareddata$\Shared\IT\AI & Automation\StatusReporting|C:\ClaudeVision\output\reports|C:\ClaudeVision\output|\\sdi-dc01\shareddata$\Shared\IT\HRSystemsOutput|\\sdi-dc01\shareddata$\Shared\Estimating\Completed\AI Estimating\Live Enquiry|\\sdi-dc01\shareddata$\Shared\IT\AI & Automation\Documentation

# File types the API may return. Anything not listed is refused.
SDI_ALLOWED_EXTENSIONS=.xlsx,.xls,.html,.htm,.json,.jpg,.jpeg,.png,.txt,.log,.docx,.doc,.pdf,.md


# ── Database (SQL Server — SDILive, or whichever DB you need) ─────────────
SDI_DB_DRIVER=ODBC Driver 18 for SQL Server
# Server, optionally with an instance:  HOSTNAME   or   HOSTNAME\INSTANCE   or   10.0.0.200
SDI_DB_SERVER=10.0.0.200
SDI_DB_NAME=SDILive

# Auth mode:  "sql"  = username + password  |  "windows" = trusted/integrated (service account)
SDI_DB_AUTH=sql
# Only needed when SDI_DB_AUTH=sql  (leave blank for windows auth)
SDI_DB_USER=AIBot
SDI_DB_PASSWORD=AIAgentPW2026

# Driver 18 encrypts by default. If the SQL Server uses a self-signed cert, keep TRUST_CERT=yes.
SDI_DB_ENCRYPT=yes
SDI_DB_TRUST_CERT=yes


# ════════════════════════════════════════════════════════════════════════
#  BrightHR -> InVentry pipeline  (HR ingestion for the COO)
# ════════════════════════════════════════════════════════════════════════
# Use "sandbox" while testing, "production" once verified.
BH_ENV=production
# Auth: "client_credentials" (app auth, NO user context) or "pat" (Personal Access Token).
# BrightHR: most endpoints need user context -> client_credentials may 403.
# If you get 403, switch to "pat" and paste a Personal Access Token below.
BH_AUTH_MODE=client_credentials
BH_CLIENT_ID=CapiApp_1ff810e3-329a-46fe-8bec-6b168ecc146e
BH_CLIENT_SECRET=K_XaAd70TFByyWqKc4ye4E5DYgvZVqMAj1o2nUyRYFA
BH_PAT=
# Space-separated scopes, if BrightHR requires them for the employee endpoint.
BH_SCOPE=
# Token URL auto-selects from BH_ENV if left blank.
BH_TOKEN_URL=https://login.brighthr.com/connect/token
# VERIFY this against BrightHR's developer docs / sandbox before production.
# BH_EMPLOYEE_URL=https://api.bright.hr/blip/v1/clockings/query
BH_EMPLOYEE_URL=https://api.bright.hr/employees/v1/query
BH_PAGE_SIZE=100
BH_MAX_PAGES=200
BH_TIMEOUT=30

# Where pulled snapshots are stored on local disk (audit trail + load source)
HR_SNAPSHOT_DIR=C:\SDIIntelligence\hr\snapshots

# InVentry watched-folder CSV (the load target — InVentry's service sweeps this)
INVENTRY_CSV_PATH=C:\InVentryImports\brighthr_staff.csv

# Safety guards
HR_MIN_RECORDS=1
HR_OUTPUT_DIR=K:\IT\HRSystemsOutput
HR_MAX_DROP_PCT=30
