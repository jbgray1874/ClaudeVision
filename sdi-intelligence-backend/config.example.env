# ════════════════════════════════════════════════════════════════════════
#  SDI Intelligence — Backend Service configuration
#  ----------------------------------------------------------------------
#  1. Copy this file to ".env"  (same folder)
#  2. Fill in every <…> placeholder with your real values
#  3. NEVER commit the populated ".env" to git / source control
#     (a .gitignore is included that already excludes it)
# ════════════════════════════════════════════════════════════════════════


# ── Service ──────────────────────────────────────────────────────────────
# Where this API listens ON THE LOCAL WINDOWS SERVER.
SDI_HOST=0.0.0.0
SDI_PORT=8071

# The portal's web address, allowed to call this API (CORS).
# Comma-separated if more than one (e.g. the SWA URL + a custom domain).
SDI_ALLOWED_ORIGINS=https://<your-portal-name>.azurestaticapps.net


# ── Access gate (interim shared secret) ──────────────────────────────────
# The portal handles the Entra ID login; THIS is a second check between the
# site and this backend. Generate one long random string and paste it both
# here and into the portal's settings. Rotate occasionally.
#   PowerShell to generate one:  [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
SDI_API_KEY=<paste-a-long-random-string-here>


# ── File shares (UNC roots this API is allowed to read) ──────────────────
# Pipe-separated ( | ) list. The API will ONLY ever serve files that sit
# UNDER one of these roots — anything else is refused (403). Keep it tight.
#   Example:
#   SDI_FILE_ROOTS=\\FILESRV01\Estimating\AI Estimating|\\FILESRV01\ClaudeVision\output
SDI_FILE_ROOTS=\\<server>\<share>\<path-one>|\\<server>\<share>\<path-two>

# File types the API may return. Anything not listed is refused.
SDI_ALLOWED_EXTENSIONS=.xlsx,.xls,.html,.htm,.json,.jpg,.jpeg,.png,.txt,.log


# ── Database (SQL Server — SDILive, or whichever DB you need) ─────────────
SDI_DB_DRIVER=ODBC Driver 18 for SQL Server
# Server, optionally with an instance:  HOSTNAME   or   HOSTNAME\INSTANCE   or   10.0.0.200
SDI_DB_SERVER=<server-or-ip>
SDI_DB_NAME=<database-name>

# Auth mode:  "sql"  = username + password  |  "windows" = trusted/integrated (service account)
SDI_DB_AUTH=sql
# Only needed when SDI_DB_AUTH=sql  (leave blank for windows auth)
SDI_DB_USER=<db-login>
SDI_DB_PASSWORD=<db-password>

# Driver 18 encrypts by default. If the SQL Server uses a self-signed cert, keep TRUST_CERT=yes.
SDI_DB_ENCRYPT=yes
SDI_DB_TRUST_CERT=yes


# ════════════════════════════════════════════════════════════════════════
#  BrightHR -> InVentry pipeline  (HR ingestion for the COO)
# ════════════════════════════════════════════════════════════════════════
# Use "sandbox" while testing, "production" once verified.
BH_ENV=sandbox
# Auth: "client_credentials" (app auth, NO user context) or "pat" (Personal Access Token).
# BrightHR: most endpoints need user context -> client_credentials may 403.
# If you get 403, switch to "pat" and paste a Personal Access Token below.
BH_AUTH_MODE=client_credentials
BH_CLIENT_ID=<brighthr-client-id>
BH_CLIENT_SECRET=<brighthr-client-secret>
BH_PAT=
# Space-separated scopes, if BrightHR requires them for the employee endpoint.
BH_SCOPE=
# Token URL auto-selects from BH_ENV if left blank.
BH_TOKEN_URL=
# VERIFY this against BrightHR's developer docs / sandbox before production.
BH_EMPLOYEE_URL=<verify-brighthr-employee-endpoint-url>
BH_PAGE_SIZE=100
BH_MAX_PAGES=200
BH_TIMEOUT=30

# Where pulled snapshots are stored on local disk (audit trail + load source)
HR_SNAPSHOT_DIR=C:\SDIIntelligence\hr\snapshots

# InVentry watched-folder CSV (the load target — InVentry's service sweeps this)
INVENTRY_CSV_PATH=C:\InVentryImports\brighthr_staff.csv

# Where the HR run writes its output. Blank uses the service's own default.
HR_OUTPUT_DIR=

# Safety guards
HR_MIN_RECORDS=1
HR_MAX_DROP_PCT=30

# ── InVentry Partner API (the supported route into InVentry) ─────────────
# See sdi-intelligence-backend/docs/INVENTRY_API_NOTES.md for the detail.
# The API is ON-PREMISES ONLY - this server must be on the same network.
#
# Base URL INCLUDING PORT 4816. The host is the main reception touchscreen
# unless your site runs its own VM for the InVentry software; InVentry support
# can confirm which.
INVENTRY_API_BASE_URL=https://<inventry-host>:4816
# InVentry console -> Setup & Options -> Partner API -> toggle ON -> Add API Key
# -> partner "End User Development" -> copy the key.
INVENTRY_API_KEY=<api key from the console>
# Issued by InVentry; the same value across their on-premises installations. It
# also appears in the Postman collection they send.
INVENTRY_PARTNER_SECRET=<partner secret from InVentry>
INVENTRY_API_TIMEOUT=30

# The certificate is self-signed. Preferred: export it from the V4 folder on the
# InVentry unit and point at it here, which keeps TLS verification ON.
INVENTRY_API_CA_BUNDLE=
# Fallback if you have no exported certificate. Only acceptable for a LAN call
# to a known host.
INVENTRY_API_VERIFY=false

# Endpoint paths, from InVentry's Postman collection. Change only if they do.
INVENTRY_PATH_CHECK_AUTH=/PartnerAPI/CheckAuth
INVENTRY_PATH_PERSONNEL=/PartnerAPI/GetPersonnel/
INVENTRY_PATH_PERSONNEL_ADD=/PartnerAPI/AddPersonnel
INVENTRY_PATH_PERSONNEL_ACTION=/PartnerAPI/AddPersonnelAction
INVENTRY_PATH_LATEST_ACTIONS=/PartnerAPI/GetLatestPersonnelActions
INVENTRY_PATH_SYSTEM_TIME=/PartnerAPI/GetSystemTime

# GetPersonnel returns staff only unless this is true.
INVENTRY_INCLUDE_NON_STAFF=false

# ActionType values. Live data shows LastActivity holding exactly IN or OUT.
INVENTRY_EVENT_TYPE_IN=IN
INVENTRY_EVENT_TYPE_OUT=OUT
INVENTRY_ACTIVITY_IN_VALUES=IN

# Sent as ActionLocation with our sign-ins, and reflected back as
# LastEventLocation. A distinctive value is how we recognise our own writes,
# which is what makes automatic sign-out safe.
INVENTRY_ACTION_LOCATION=BRIGHTHR SYNC

# Sign people OUT when BrightHR no longer shows them clocked in. Leave false
# until /api/hr/inventry/check confirms our marker round-trips on the live
# system. With ONLY_SIGN_OUT_OUR_OWN on, a sign-in made at reception is never
# undone by this sync.
INVENTRY_ENABLE_SIGN_OUT=false
INVENTRY_ONLY_SIGN_OUT_OUR_OWN=true
INVENTRY_MAX_SIGN_OUTS_PER_RUN=25

# ── Branding ─────────────────────────────────────────────────────────────
# The portal header and the client quote read the SAME folder on purpose: a logo kept in two
# places drifts, and the customer-facing document is the one that must never be wrong.
#
# assets/ is NOT in git — it holds customer logos, which are not ours to redistribute. So on a
# new machine this folder exists in the settings and not on the disk, the header falls back to
# its lettermark, and nothing says why. Copy the folder across by hand as part of a deploy.
SDI_BRAND_ASSETS_DIR=C:\ClaudeVision\assets\customer_logos
SDI_BRAND_LOGO_KEY=wearesdi
# Microsoft Entra ID single sign-on
# SSO stays OFF until all four of these are set. See APP_PORTAL_RUNBOOK.md §2.
# ─────────────────────────────────────────────────────────────────────────────
SDI_TENANT_ID=<Directory (tenant) ID from the app registration>
SDI_CLIENT_ID=<Application (client) ID>
SDI_CLIENT_SECRET=<the client secret VALUE, shown once when created>
SDI_SESSION_SECRET=<any long random string — this signs the session cookie>

SDI_REDIRECT_URI=http://localhost:8071/auth/callback
SDI_SESSION_HOURS=10

# Delegated Graph scopes, space separated. The app can never see more than the
# signed-in person can. Add Sites.Read.All when wiring up the Voice CRM app.
SDI_GRAPH_SCOPES=User.Read

# Optional second check on top of enterprise-app assignment. Needs a groups
# claim configured, and denies users who are in 200+ groups. Usually leave blank.
SDI_ALLOWED_GROUPS=

# Set to "no" ONLY while testing over plain http on the intranet.
# Remove it once the portal is on HTTPS.
SDI_COOKIE_SECURE=yes

# Keeps X-SDI-Key working for scheduled scripts during the changeover.
# Set to "no" once nothing uses it — then every request is attributable.
SDI_ALLOW_API_KEY=yes

# ─────────────────────────────────────────────────────────────────────────────
# Voice-Activated CRM (sandbox pilot) — read-only. See APP_PORTAL_RUNBOOK.md §4.3
# ─────────────────────────────────────────────────────────────────────────────
SDI_VOICECRM_SITE=<hostname:/sites/SiteName>
SDI_VOICECRM_LIST=<List display name or ID>
SDI_VOICECRM_OWNER=NG
SDI_VOICECRM_OWNER_FIELD=AMOwner

# Where the encrypted session database lives (default: beside app.py).
SDI_SESSION_DB=

# ── Voice CRM write path — OFF until the List exists and Nick has approved ──
# Both of these must be set before anything can be written. EDITABLE is an
# allow-list: no column outside it can ever be changed.
SDI_VOICECRM_WRITE=no
SDI_VOICECRM_APPROVED_BY=
SDI_VOICECRM_EDITABLE=Status,NextAction,NextActionDate
SDI_VOICECRM_JOURNAL_DB=

# ── Public exposure ──
# When the portal is reached over the internet (tunnel / App Proxy), only the
# app portal and its APIs are served under these hostnames; the file browser,
# database, estimating and architecture pages return 404. Internal access is
# unaffected. Comma-separated. Empty = guard off.
SDI_PUBLIC_HOSTS=apps.wearesdi.com
