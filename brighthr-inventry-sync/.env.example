# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# --- BrightHR -----------------------------------------------------------
# app.brighthr.com -> Settings -> Integrations -> Customer API -> Generate key
BRIGHTHR_API_KEY=
BRIGHTHR_BASE_URL=https://api.brighthr.com/v1
BRIGHTHR_TIMEOUT_SECONDS=30
BRIGHTHR_MAX_RETRIES=3
BRIGHTHR_RETRY_BACKOFF_SECONDS=2
# Endpoint paths - change only if BrightHR's API differs from the handover.
BRIGHTHR_EVENTS_PATH=/attendance/events
BRIGHTHR_EMPLOYEES_PATH=/employees
BRIGHTHR_ABSENCES_PATH=/absences
# Set false if the tenant rejects ?status=clocked_in; the client then replays
# the last 24h of events instead.
BRIGHTHR_SUPPORTS_STATUS_FILTER=true

# --- InVentry -----------------------------------------------------------
# dryrun = simulate, write nothing (default until InVentry provide access)
# sqlserver = write to the InVentry database over ODBC
INVENTRY_DRIVER=dryrun
INVENTRY_DB_SERVER=
INVENTRY_DB_NAME=
INVENTRY_DB_USER=
INVENTRY_DB_PASSWORD=
INVENTRY_ODBC_DRIVER=ODBC Driver 18 for SQL Server
INVENTRY_ENCRYPT=true
INVENTRY_TRUST_SERVER_CERTIFICATE=false

# Schema - the handover's approximate guess. CONFIRM WITH INVENTRY SUPPORT
# before switching INVENTRY_DRIVER to sqlserver.
INVENTRY_TABLE=InVentry_Staff_OnSite
INVENTRY_COL_STAFF_ID=StaffID
INVENTRY_COL_STAFF_NAME=StaffName
INVENTRY_COL_SIGN_IN=SignInTime
INVENTRY_COL_SIGN_OUT=SignOutTime
INVENTRY_COL_LOCATION=Location
INVENTRY_COL_UPDATED_AT=UpdatedAt
# Column marking who wrote the row, so manual terminal sign-ins are never
# auto-signed-out. Leave empty if the real schema has no such column.
INVENTRY_COL_SOURCE=UpdatedBy
INVENTRY_SOURCE_TAG=BRIGHTHR_SYNC

# --- Sync behaviour -----------------------------------------------------
SITE_NAME=Shepshed
SYNC_INTERVAL_MINUTES=5
# Staff on a break are still in the building, so they stay on the fire roll.
SYNC_TREAT_BREAK_AS_ON_SITE=true
SYNC_CHECK_ABSENCES=true
SYNC_RESPECT_MANUAL_SIGN_IN=true

# Safety rails - stop a bad BrightHR response emptying the evacuation list.
SYNC_MAX_SIGN_OUTS_PER_RUN=25
SYNC_MAX_SIGN_OUT_RATIO=0.5
SYNC_ALLOW_FULL_SIGN_OUT=false
SYNC_SIGN_OUT_UNMAPPED=false

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=90
# LOG_PATH=C:\SDI\brighthr-inventry-sync\logs
