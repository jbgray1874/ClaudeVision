# The repository root .gitignore excludes *.json / *.txt / *.log globally.
# This project needs its config and requirements files tracked, so re-include
# them explicitly here. Real secrets and live data stay ignored below.
!*.json
!requirements.txt
!*.md

# Never commit real credentials or live employee data
.env
config.local.json
employee_map.json
logs/
*.log
state/
