{
  "_comment": [
    "Maps BrightHR JSON field names onto the names this sync uses internally.",
    "The exact BrightHR field names are an open question in the handover, so each",
    "logical field lists candidate keys tried in order. Matching is",
    "case-insensitive and ignores underscores/hyphens, and dotted paths such as",
    "'employee.id' walk into nested objects.",
    "When the real BrightHR JSON is available, run:",
    "    python tools/inspect_brighthr_json.py sample.json",
    "which reports which candidates matched and what is still unmapped."
  ],
  "events_root": ["events", "data", "items", "results", "records"],
  "employees_root": ["employees", "data", "items", "results", "records"],
  "absences_root": ["absences", "data", "items", "results", "records"],
  "event": {
    "employee_id": ["employee_id", "employeeId", "employee.id", "staffId", "userId", "id"],
    "employee_name": [
      "employee_name",
      "employeeName",
      "employee.name",
      "fullName",
      "displayName",
      "name"
    ],
    "event_type": ["event_type", "eventType", "type", "action", "status", "clockType"],
    "timestamp": [
      "timestamp",
      "eventTime",
      "occurredAt",
      "dateTime",
      "clockTime",
      "createdAt",
      "time"
    ],
    "location": ["location", "site", "siteName", "locationName", "office"],
    "device_id": ["device_id", "deviceId", "terminalId", "device.id", "blipId"]
  },
  "employee": {
    "employee_id": ["employee_id", "employeeId", "id", "staffId"],
    "employee_name": ["employee_name", "employeeName", "fullName", "displayName", "name"],
    "first_name": ["first_name", "firstName", "forename", "givenName"],
    "last_name": ["last_name", "lastName", "surname", "familyName"],
    "email": ["email", "emailAddress", "workEmail"],
    "employee_number": ["employee_number", "employeeNumber", "payrollNumber", "staffNumber"]
  },
  "absence": {
    "employee_id": ["employee_id", "employeeId", "employee.id", "staffId"],
    "start_date": ["start_date", "startDate", "from", "fromDate", "start"],
    "end_date": ["end_date", "endDate", "to", "toDate", "end"],
    "absence_type": ["absence_type", "absenceType", "type", "category", "reason"],
    "status": ["status", "approvalStatus", "state"]
  },
  "event_types": {
    "_comment": "BrightHR event type values grouped by what they mean for presence. Values are compared case-insensitively with underscores/hyphens/spaces ignored.",
    "clock_in": ["clock_in", "clockin", "in", "start", "shift_start", "startShift"],
    "clock_out": ["clock_out", "clockout", "out", "end", "shift_end", "endShift", "finish"],
    "break_start": ["break_start", "breakstart", "break", "break_out", "startBreak", "lunch_start"],
    "break_end": ["break_end", "breakend", "break_in", "endBreak", "lunch_end", "resume"]
  },
  "absence_statuses_blocking": ["approved", "authorised", "authorized", "accepted", "confirmed"]
}
