# The Live Enquiry runner (src\live_enquiry_runner.py, D-420). Add these to C:\ClaudeVision\.env.
# UNC paths, never a drive letter: K: is per-logon and absent for a service account.

# The estimators' workbook. Read only; the runner never writes it.
SDI_LIVE_ENQUIRY_WORKBOOK=\\sdi-dc01\shareddata$\Shared\Estimating\<where it lives>\Live Enquiry.xlsx
SDI_LIVE_ENQUIRY_SHEET=Sheet1
# Only if the workbook carries a password (needs: pip install msoffcrypto-tool)
SDI_LIVE_ENQUIRY_PASSWORD=

# The packs: <root>\<customer folder>\<drawing folder>\<drawings>
SDI_LIVE_ENQUIRY_ROOT=\\sdi-dc01\shareddata$\Shared\Estimating\Completed\AI Estimating\Live Enquiry

# The portal it queues through (the runner's own names)
SDI_SERVER=http://10.0.0.5:8071
SDI_API_KEY=

# Who the finished estimate is e-mailed to. Empty: filed, sent to nobody.
SDI_LIVE_ENQUIRY_EMAIL_TO=

SDI_LIVE_ENQUIRY_POLL_MINUTES=15
SDI_LIVE_ENQUIRY_RUN_TIMEOUT_MINUTES=240
SDI_LIVE_ENQUIRY_MAX_ATTEMPTS=1

# The design area, when its endpoint is given. Unset: the share is the only source.
SDI_DESIGN_AREA_ENDPOINT=
