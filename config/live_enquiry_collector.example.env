# Copy to C:\ClaudeVision\.env or set in Windows user environment.
# Live Enquiry drawing collector — watches the manual estimate list and copies PDF/DXF packs.

# --- Paths (adjust if your drive letters differ) ---
LIVE_ENQUIRY_WORKBOOK=K:\Estimating\Completed\Manual Estimates\Live Enquiry.xls
LIVE_ENQUIRY_SHEET=Live Enquiries
PRODUCTION_ROOT=W:\Production
AI_ENQUIRY_DEST=K:\Estimating\Completed\AI Estimating\Live Enquiry
STATE_FILE=C:\ClaudeVision\output\live_enquiry_collector_state.json

# --- Watcher ---
LIVE_ENQUIRY_POLL_SECONDS=60

# --- Search ---
DRAWING_SEARCH_MAX_DEPTH=12
COPY_DXF_TO_SUBFOLDER=0

# --- Email (SMTP) — required for notifications ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your.name@wearesdi.com
SMTP_PASSWORD=
SMTP_FROM=your.name@wearesdi.com
LIVE_ENQUIRY_EMAIL_TO=james.gray@wearesdi.com

# Optional: only process rows whose "Enquiry Received" is within N days (0 = all rows)
LIVE_ENQUIRY_MAX_AGE_DAYS=14
