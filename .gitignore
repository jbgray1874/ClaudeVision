# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/

# Virtual environments (never commit these)
venv/
.venv/
env/
.env
!config/*.example.env

# ── Output data (VERY IMPORTANT) ─────────────────────────────────────────
output/
*.json
*.jsonl
*.log
*.txt

# ── Input data (drawings, spreadsheets) ──────────────────────────────────
input/

# PDFs, images and workbooks (CRITICAL — job data, never commit)
*.pdf
*.png
*.jpg
*.jpeg
*.xls
*.xlsx

# ── Backups / scratch ────────────────────────────────────────────────────
*.bak
*.bak_*
*.backup
*~

# SQL dumps (schema lives in versioned .sql under sql/ if needed)
*.sql

# ── OS ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Explicit keeps (override the broad ignores above) ────────────────────
!requirements.txt
!corpus/*.jsonl
cache/
