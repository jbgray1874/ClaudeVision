# Python
__pycache__/
*.pyc
.venv/
 
# Output data (VERY IMPORTANT) 
output /
*.json
*.log
*.txt

# Input data ( optional but recommended )
input/

#PDFs and images (CRITICAL)
*.pdf
*.png
*.jpg
*.jpeg

# OS
.DS_Store
Thumbs.db

output/
*.bak
*.xlsx

*.sql
# ── SDI Intelligence app portal ──
# The repo ignores *.json and *.png wholesale (output data). These are source,
# not output, so they are tracked deliberately.
!sdi-intelligence-backend/services.json
!sdi-intelligence-backend/appportal/*.png

# Secrets. NOTE: .env is ALREADY TRACKED — this line stops future ones being
# added, it does NOT untrack the existing file. See appportal/README.md.
.env

# Runtime databases — sessions (encrypted) and the Voice CRM update journal.
# Never commit these: one holds refresh tokens, the other is an audit trail.
sdi-intelligence-backend/*.db
sdi-intelligence-backend/*.db-wal
sdi-intelligence-backend/*.db-shm
